package: DNA
author: Contributors to the Dailies Notes Assistant Project
organization: Academy Software Foundation
version: 0.1
requires: ''
rv: 2024.0.0
openrv: 2.0.0
optional: true

modes:
  - file: rv_dna_mode
    load: immediate

description: |
  <p>Connects RV to DNA (Dailies Notes Assistant).</p>
  <p>Adds a <b>DNA</b> menu to sign in and out of a DNA server. Set the DNA
  web app URL from <b>DNA &gt; Set DNA URL...</b>, then choose
  <b>DNA &gt; Sign In...</b>.</p>
